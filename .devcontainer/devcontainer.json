{
  "name": "Alreo (dev)",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "alreo",
  "workspaceFolder": "/app",
  "forwardPorts": [5000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
